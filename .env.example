# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL credentials used by compose.yml
POSTGRES_USER=centinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=centinel
POSTGRES_PORT=5432

# Connection URL used by the app and Alembic (must match the values above)
DATABASE_URL=postgresql+psycopg://centinel:change-me@localhost:5432/centinel

# Database the tests use: the db-test service in compose.yml. The tests drop
# every table, so never point it at DATABASE_URL.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://centinel:change-me@localhost:5433/centinel_test

# Required. Your timezone (IANA name), used to resolve dates like "today" or
# "this month". Set it to where you are, not where the server runs.
TIMEZONE=America/Lima

# Gmail intake through the Apps Script in apps_script/ (see apps_script/README.md).
# Leave both empty to register expenses only by chat.
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
# How many days back each email search looks
EMAIL_LOOKBACK_DAYS=30
